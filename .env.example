# Este arquivo e para rodar a app direto no host (venv). Para o ambiente Docker
# (app + MySQL via docker-compose), use .env.docker.example -> .env.docker.

# Obrigatoria
SECRET_KEY=troque_esta_chave

# Banco (escolha um)
# DATABASE_URL=mysql+pymysql://usuario:senha@host/banco
# DATABASE_URL=sqlite:///instance/database.db

# Caminho de rede (opcional; tambem configuravel na tela de Configuracoes,
# que tem precedencia sobre esta variavel)
# CAMINHO_REDE=Z:\\PASTAS EMPRESAS

# Perfil do Chrome (opcional)
# CHROME_PROFILE_DIR=C:\\CertidoesPython\\chrome-profile
# CHROME_PROFILE_NAME=Certidoes

# Logs (opcional)
# LOG_LEVEL=INFO
# QUIET_WERKZEUG_LOGS=true
# Saida dupla: console legivel para humano + arquivo JSON cru para a IA
# LOG_DIR=logs
# LOG_CONSOLE_FORMAT=human   # human (legivel) ou json (cru)
# LOG_JSON_FILE=true         # grava logs/app.jsonl (rotativo)

# Diagnostico: historico de erros persistido em banco (sobrevive a restart)
# DIAGNOSTICO_PERSISTIR=true
# DIAGNOSTICO_RETENCAO_DIAS=30

# Captura de contexto na falha Selenium (screenshot + HTML em logs/selenium)
# SELENIUM_CAPTURE_ENABLED=true
# SELENIUM_CAPTURE_DIR=logs/selenium
# SELENIUM_CAPTURE_RETENCAO_DIAS=14

# Certificado Estadual RS (opcional)
# SUBJECT e a chave: e ele que o sistema procura no repositorio de certificados
# do Windows, e ele nao muda na renovacao (nome do titular + CPF/CNPJ).
# ISSUER e so o FALLBACK, usado quando o certificado nao esta instalado: a AC
# emissora troca de uma renovacao para outra e o valor daqui envelhece sozinho.
# RS_CERT_AUTOSELECT_ENABLED=true
# RS_CERT_AUTOSELECT_PATTERN=https://www.sefaz.rs.gov.br
# RS_CERT_AUTOSELECT_POLICY_INDEX=1
# RS_CERT_AUTOSELECT_ISSUER_CN=AC emissora
# RS_CERT_AUTOSELECT_SUBJECT_CN=Titular CPF

# Certificado da NFSe - Emissor Nacional (opcional)
# Sem isto o Chrome abre o dialogo de certificado e o operador escolhe a mao.
# POLICY_INDEX precisa ser diferente do usado pelo RS: sao certificados
# distintos e as duas politicas convivem no registro.
# ISSUER e SUBJECT sao ambos obrigatorios - existem certificados com o mesmo
# titular e emissores diferentes, e filtrar so pelo titular e ambiguo.
# Como no RS, o ISSUER e resolvido no store pelo SUBJECT quando o certificado
# esta instalado; o valor daqui e o fallback.
# NFSE_CERT_AUTOSELECT_ENABLED=true
# NFSE_CERT_AUTOSELECT_PATTERN=https://certificado.nfse.gov.br
# NFSE_CERT_AUTOSELECT_POLICY_INDEX=2
# NFSE_CERT_AUTOSELECT_ISSUER_CN=AC emissora
# NFSE_CERT_AUTOSELECT_SUBJECT_CN=Titular CNPJ

# ALTCHA RS em lote (opcional)
# RS_ALTCHA_AUTOSOLVE_ENABLED=true
# RS_ALTCHA_MANUAL_FALLBACK=true
# CAPTCHA_2_API_KEY=sua_chave
# CAPTCHA_2_DEFAULT_TIMEOUT=180
# CAPTCHA_2_POLLING_INTERVAL=10
# CAPTCHA_2_SERVER=2captcha.com

# Notificacoes por e-mail (spec 03) — credenciais SOMENTE aqui, nunca no banco.
# Destinatarios e cadencia do digest sao configurados no painel (Configuracoes).
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=certidoes@suaempresa.com
# SMTP_USE_TLS=true
# SMTP_TIMEOUT=20
# NOTIF_DIGEST_ENVIAR_VAZIO=true    # envia "tudo em dia" quando nao ha novidade
# NOTIF_ALERTA_JANELA_HORAS=24      # anti-spam entre alertas iguais

# Resiliencia operacional (spec 09)
# BREAKER_LIMIAR=3                  # falhas seguidas do mesmo portal que abrem o breaker
# BREAKER_JANELA_MINUTOS=60         # quanto tempo o breaker fica aberto (fecha sozinho)
# PORTAL_PING_TTL_MINUTOS=5         # cache do ping de saude (nao martelar o portal)
# PORTAL_PING_TIMEOUT_S=6           # teto de espera de cada ping de portal
