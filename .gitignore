# Ambiente virtual
venv/

# Arquivos de cache do Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
logs/

# Pasta de instância do Flask
instance/

# Arquivos de ambiente
.env
.env.*
!.env.example
# Exemplo do compose e versionado; o .env.docker real continua ignorado por .env.*
!.env.docker.example

# Perfil dedicado do Chrome / dados locais da automação
chrome-profile/
# Perfil dedicado do Chrome para fluxos municipais IPM (undetected-chromedriver)
chrome-profile-municipal/
# Perfil do spike de recon Federal (spec 07, undetected-chromedriver)
chrome-profile-federal-recon/
chrome-profile-federal-real/

# Configurações do editor de código
.vscode/
.idea/

# Ferramentas/testes
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build/empacotamento
build/
dist/
*.egg-info/
node_modules/

# Comandos do flask que serao sempre rodados
.flaskenv
app/stop_federal_monitor.txt
docs/todo.txt

# Arquivo de contexto do sistema (sensível)
docs/context.json
docs/MAPEAMENTO_MUNICIPIOS.md

# Specs de trabalho (não versionadas)
docs/specs/

# Plano de identidade (uso local, não versionado)
docs/IDENTIDADE_ZELO.md

# Análise de arquitetura (uso local, não versionada)
docs/ANALISE_ARQUITETURA.md

# Guia de design language (uso local, não versionado)
docs/DESIGN_LANGUAGE.md

# Bancos locais
*.sqlite3
*.db

# Harness de UI (mockups, paginas de inspecao e scripts de screenshot): material
# de TRABALHO, nao codigo do app — nada aqui e usado pelo app, pelos testes ou
# pelo CI. Fica so na maquina. Os geradores da marca sao a excecao: eles
# produzem assets que ESTAO versionados em app/static/images.
tools/ui-harness/*
!tools/ui-harness/gen_zelo_mark.py
!tools/ui-harness/gen_zelo_lockup.py

# Claude Code — versiona .claude/skills (compartilhado); ignora config pessoal/local
.claude/settings.local.json
# Skill instalada localmente (uso pessoal, não versionada)
.claude/skills/tlc-spec-driven/

# Skills locais com material operacional (uso pessoal, não versionadas).
# Mesma regra de CLAUDE.md, AGENTS.md e .specs/: procedimento de ambiente e
# detalhe de operação ficam só na máquina.
.claude/skills/gate-mysql/
.claude/skills/pr-zelo/
.claude/skills/migration-segura/
.claude/skills/nfse-invariantes/
.claude/skills/portal-recon/
.claude/skills/triagem-log/
.claude/skills/sync-contexto/

# Specs de trabalho da skill spec-driven (uso local, não versionadas)
.specs/

# Rascunho de execucao dos agentes e artefatos de teste (apagavel a qualquer momento)
tmp/
.pytest-tmp*/

# Artefatos locais diversos
Thumbs.db
Desktop.ini
.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
SMOKE_TEST.md
logs/app.jsonl

# gatilho de reload do servidor de desenvolvimento
reload.trigger

# Estado vivo de handoff entre agentes (local, não versionado)
.handoff/
